<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".BodiesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/transparent"
            app:cardCornerRadius="20dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            app:cardElevation="0dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Add Dead Body"
                    android:textColor="@color/BG"
                    android:textStyle="bold"
                    android:textSize="25sp"/>


            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="9"
            app:cardElevation="4dp"
            android:layout_marginHorizontal="8dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceTopRounded"
            android:backgroundTint="@color/FG"
            >
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="26dp">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:hint="Expected Age of Body"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/BG"
                        app:boxStrokeWidth="2dp"
                        app:hintTextColor="@color/BG"

                        >
                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:textSize="15sp"
                            android:padding="12dp"
                            android:inputType="numberDecimal"
                            android:layout_marginTop="5dp"
                            android:gravity="center_horizontal"
                            android:layout_marginBottom="10dp"
                            />

                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:hint="Date of Submission"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/BG"
                        app:boxStrokeWidth="2dp"
                        app:hintTextColor="@color/BG"

                        >
                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/poppins_medium"
                            android:textSize="15sp"
                            android:padding="12dp"
                            android:inputType="date"
                            android:layout_marginTop="5dp"
                            android:gravity="center_horizontal"
                            android:layout_marginBottom="10dp"
                            />

                    </com.google.android.material.textfield.TextInputLayout>

                    <RadioGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal"
                        tools:ignore="MissingClass">


                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Male"
                            android:textColor="@color/BG"
                            android:fontFamily="@font/poppins_medium"
                            app:buttonTint="@color/BG" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Female"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="@color/BG"
                            app:buttonTint="@color/BG"/>
                    </RadioGroup>


                    <!-- Square Image View to Display Selected Image -->
                    <ImageView
                        android:id="@+id/BodyPicture"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginVertical="10dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/morgue_clip"
                        android:background="@android:color/darker_gray" />

                    <!-- Button to Open Gallery or Camera -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/select_image_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Upload or Capture"
                        android:textSize="15sp"
                        app:cornerRadius="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginHorizontal="20dp"
                        android:backgroundTint="@color/BG"
                        android:fontFamily="@font/poppins_medium" />

                    <!-- GridLayout with 3 Columns for Image/Color Display -->
                    <GridLayout
                        android:id="@+id/gvUnBodies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:columnCount="3"
                        android:rowCount="1"
                        android:orientation="horizontal" />

                </LinearLayout>

            </ScrollView>


        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</FrameLayout>